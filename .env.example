# Copy to .env for local dev, or .env.production before `npm run build`
# to point the deployed frontend at your live backend.

VITE_API_BASE_URL=http://localhost:8000

# Required for login/auth (src/supabaseClient.js creates the Supabase
# client unconditionally at module load, so the app throws a blank-screen
# error on startup if these are left unset). Get these from your Supabase
# project's Settings > API page.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
